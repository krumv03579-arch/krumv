# Supabase connection.
#
# These are optional: src/integrations/supabase/config.ts already carries the
# project's own values so a fresh clone runs without any setup. Set them to
# point the app at a different project (a staging one, for example).
#
# The publishable key is a browser key — it ships in the client bundle either
# way, and row level security is what guards the data.
VITE_SUPABASE_URL=https://efgggrjoknbwbwbwhejd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YavXhAt6v8Ui7O-RRjLSyQ_b-DUatyA

# Server-only. Bypasses row level security, so it must never be committed or
# exposed to the browser; set it in the deployment environment when a server
# route needs admin access.
# SUPABASE_SERVICE_ROLE_KEY=
